{
  "OrderSimulator": {
    "Enabled": false,
    "IntervalSeconds": 5,
    "OrdersPerTick": 500
  },
  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost;Database=OrderDB;User Id=sa;Password=Asdf1234;Connect Timeout=60;Min Pool Size=20;Max Pool Size=300;TrustServerCertificate=True;"
  },
  "MongoDb": {
    "ConnectionString": "mongodb://localhost:27017",
    "DatabaseName": "OrderSagaDb"
  },
  "Redis": {
    "ConnectionString": "localhost:6379",
    "ConnectTimeoutMs": 10000,
    "SyncTimeoutMs": 10000,
    "AbortOnConnectFail": true
  },
  "Hangfire": {
    "WorkerCount": 10,
    "Queues": [ "default", "mt-message-queue" ],
    "ServerTimeout": "00:02:00",
    "ServerCheckInterval": "00:00:30",
    "InvisibilityTimeout": "00:05:00",
    "JobExpirationTimeout": "0.00:02:00"
  },
  "RabbitMQ": {
    "Host": "localhost",
    "VirtualHost": "/",
    "Username": "admin",
    "Password": "Asdf1234",

    "PrefetchCount": 32,
    "ConcurrentMessageLimit": 16,

    "RateLimit": 1000,

    "MessageDeliveryLimit": 5,
    "MessageDeliveryTimeoutSeconds": 60,

    "QueryMessageLimit": 50,
    "QueryDelaySeconds": 30,
    "QueryTimeoutSeconds": 30,

    "HeartbeatSeconds": 10,
    "RequestedConnectionTimeoutSeconds": 15
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.MongoDB", "Serilog.Sinks.Console" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "MongoDBBson",
        "Args": {
          "databaseUrl": "mongodb://localhost:27017/OrderSagaDb",
          "collectionName": "Logs"
        }
      },
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {Message:lj}{NewLine}{Exception}"
        }
      }
    ],
    "Enrich": [ "FromLogContext", "WithMachineName" ],
    "Properties": {
      "Application": "MicroService"
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
